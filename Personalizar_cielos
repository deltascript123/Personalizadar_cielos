local function saveTime()
    if savedClockTime == nil then
        savedClockTime = Lighting.ClockTime
        savedBrightness = Lighting.Brightness
    end
end

local function clearShaders()
    if currentAtmosphere then currentAtmosphere:Destroy() currentAtmosphere = nil end
    if currentColorCorrection then currentColorCorrection:Destroy() currentColorCorrection = nil end
    if currentSunRays then currentSunRays:Destroy() currentSunRays = nil end
end

local function restoreTime()
    if savedClockTime ~= nil then
        Lighting.ClockTime = savedClockTime
        Lighting.Brightness = savedBrightness
        savedClockTime = nil
        savedBrightness = nil
    end
end

local function applyShader(hour, brightness, tintColor, atmoColor, atmoDecay, atmoDensity, atmoHaze, atmoGlare, saturation, contrast, sunRaysIntensity, keepSky)
    saveTime()
    clearShaders()

    if not keepSky then
        Lighting.ClockTime = hour
        Lighting.Brightness = brightness
    end

    if atmoColor then
        local atmo = Instance.new("Atmosphere")
        atmo.Density = atmoDensity
        atmo.Offset = 0.25
        atmo.Color = atmoColor
        atmo.Decay = atmoDecay
        atmo.Glare = atmoGlare
        atmo.Haze = atmoHaze
        atmo.Parent = Lighting
        currentAtmosphere = atmo
    end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Brightness = 0.02
    cc.Contrast = contrast
    cc.Saturation = saturation
    cc.TintColor = tintColor
    cc.Parent = Lighting
    currentColorCorrection = cc

    if sunRaysIntensity > 0 then
        local sr = Instance.new("SunRaysEffect")
        sr.Intensity = sunRaysIntensity
        sr.Spread = 1
        sr.Parent = Lighting
        currentSunRays = sr
    end
end

