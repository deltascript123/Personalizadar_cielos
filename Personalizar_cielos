local function getSky()
    if mySky and mySky.Parent then
        return mySky
    end
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") and obj.Name == "MyCustomSky" then
            mySky = obj
            return obj
        end
    end
    local sky = Instance.new("Sky")
    sky.Name = "MyCustomSky"
    sky.SunAngularSize = 21
    sky.MoonAngularSize = 11
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
    mySky = sky
    return sky
end

local function applySkyById(id)
    id = tostring(id):gsub("%s", ""):gsub("rbxassetid://", "")
    if id == "" then return end
    local asset = "rbxassetid://" .. id
    local sky = getSky()
    sky.SkyboxBk = asset
    sky.SkyboxDn = asset
    sky.SkyboxFt = asset
    sky.SkyboxLf = asset
    sky.SkyboxRt = asset
    sky.SkyboxUp = asset
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
    Lighting.Ambient = Color3.fromRGB(120, 120, 120)
end

local function applyCubemap(entry)
    local sky = getSky()
    sky.SkyboxBk = "rbxassetid://" .. entry.Bk
    sky.SkyboxDn = "rbxassetid://" .. entry.Dn
    sky.SkyboxFt = "rbxassetid://" .. entry.Ft
    sky.SkyboxLf = "rbxassetid://" .. entry.Lf
    sky.SkyboxRt = "rbxassetid://" .. entry.Rt
    sky.SkyboxUp = "rbxassetid://" .. entry.Up
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
    Lighting.Ambient = Color3.fromRGB(120, 120, 120)
end

local function resetSky()
    if mySky then
        mySky:Destroy()
        mySky = nil
    end
end

